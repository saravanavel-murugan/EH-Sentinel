# EventHub Ops - Sentinel : environment template
# Copy to .env and fill in real values. NEVER commit a real .env (see .gitignore).
# No secrets are ever placed in prompts, logs, or incident summaries.

# ======================================================================
# QUICK SWITCH — run EVERYTHING on OpenAI
# Set these three and all agents (Phase 3 single-node + Phase 3b A1-A8)
# and Phase 4 retrieval embeddings use OpenAI:
#   SENTINEL_LLM=openai
#   SENTINEL_EMBEDDINGS=openai
#   OPENAI_API_KEY=sk-...
# Leave them at the "fake" defaults to run fully offline (no key).
# ======================================================================

# --- LLM provider selection (Phase 3) ---
# "openai"  -> live OpenAI via langchain-openai (requires OPENAI_API_KEY below)
# "fake"    -> offline deterministic fake chat model (no network, no key).
SENTINEL_LLM=fake

# --- Embeddings provider selection (Phase 4) ---
# "openai"  -> OpenAI embeddings (requires OPENAI_API_KEY below)
# "fake"    -> offline deterministic hashing embedder (no network, no key).
SENTINEL_EMBEDDINGS=fake

# --- OpenAI (used when SENTINEL_LLM=openai and/or SENTINEL_EMBEDDINGS=openai) ---
OPENAI_API_KEY=
# Optional overrides:
SENTINEL_OPENAI_MODEL=gpt-4o-mini
SENTINEL_LLM_TEMPERATURE=0
SENTINEL_OPENAI_EMBED_MODEL=text-embedding-3-small
# Embedding vector dimension for the offline fake embedder (and index metadata).
SENTINEL_EMBED_DIM=256

# --- default prompt strategy version (v1 | v2 | v3) ---
# v3 is the recommended default (see docs/prompt_comparison_table.md).
SENTINEL_PROMPT_VERSION=v3

# --- retrieval (Phase 4) ---
SENTINEL_RETRIEVAL_TOP_K=3
# Minimum cosine similarity for a chunk to count as relevant; below this the
# retriever reports "no relevant info found". 0.30 suits the offline fake
# (lexical) embedder; with OpenAI embeddings on/off-domain separate much more
# sharply, so a lower value (e.g. 0.25) also works there.
SENTINEL_RETRIEVAL_MIN_SCORE=0.30
